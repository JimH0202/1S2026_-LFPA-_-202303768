digraph Hospital {
  rankdir=LR;
  node [shape=box, style=rounded, color="#667eea", fontname="Arial"];
  edge [color="#666", fontname="Arial"];

  hospital [label="
HOSPITAL", shape=ellipse, color="#ff6b6b", fontcolor=white, style=filled];

  subgraph cluster_pacientes {
    label="PACIENTES";
    color="#4ecdc4";
    style=filled;
    fillcolor="#e8f8f5";
    pac_8501 [label="\nAna López\nEdad: 34\nSangre: O+"];
    hospital -> pac_8501;
    pac_4856 [label="\nJuan Pérez\nEdad: 50\nSangre: B-"];
    hospital -> pac_4856;
    pac_4897 [label="\nLaura Díaz\nEdad: 28\nSangre: A+"];
    hospital -> pac_4897;
  }

  subgraph cluster_medicos {
    label="MÉDICOS";
    color="#95e1d3";
    style=filled;
    fillcolor="#f0fdf4";
    med_7785 [label="\nDr. Carlos Ruiz\nCARDIOLOGIA\nMED-001"];
    hospital -> med_7785;
    med_1231 [label="\nDra. María Solís\nNEUROLOGIA\nMED-002"];
    hospital -> med_1231;
  }

  subgraph cluster_citas {
    label="CITAS";
    color="transparent";
    pac_8501 -> med_7785 [label="2025-04-10 09:00", color="green", style="solid"];
    pac_4856 -> med_1231 [label="2025-04-11 14:30", color="green", style="solid"];
    pac_4897 -> med_7785 [label="2025-04-12 10:00", color="green", style="solid"];
  }

  subgraph cluster_especialidades {
    label="ESPECIALIDADES";
    color="#ffeaa7";
    style=filled;
    fillcolor="#fffaed";
    esp_5596 [label="CARDIOLOGIA"];
    esp_6447 [label="NEUROLOGIA"];
  }

  subgraph cluster_sangre {
    label="TIPOS DE SANGRE";
    color="#ff7675";
    style=filled;
    fillcolor="#ffebee";
    sangre_7919 [label="O+", shape=oval];
    sangre_2567 [label="B-", shape=oval];
    sangre_9105 [label="A+", shape=oval];
  }

  // Leyenda
  subgraph cluster_legend {
    label="Leyenda";
    color="gray";
    ok_edge [label="Cita OK", color="green"];
    conflict_edge [label="Cita en conflicto", color="red"];
  }
}
